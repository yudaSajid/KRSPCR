  "version": "1.0.0",
  "description": "Backend API for Academic KRS System with 5 Million Rows Scale",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
